<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="0dp"
    android:background="#FFFFFF">

    <!-- Encabezado superior -->
    <LinearLayout
        android:id="@+id/headerSuperior"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#CC1D00"
        android:paddingStart="8dp">

        <TextView
            android:id="@+id/btnVolverFlecha"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:gravity="center"
            android:text="‹"
            android:textColor="#FFFFFF"
            android:textSize="56sp"
            android:fontFamily="sans-serif-light"
            android:includeFontPadding="false"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Volver a la pantalla anterior" />

    </LinearLayout>





    <!-- Contenedor del formulario -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingBottom="48dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:gravity="center"
            android:text="Control de acceso"
            android:textColor="#202124"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ingresa tus credenciales para continuar"
            android:textSize="14sp"
            android:textColor="#757575"
            android:gravity="center"
            android:layout_marginBottom="32dp" />

        <EditText
            android:id="@+id/etUsuario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Usuario"
            android:inputType="text"
            android:maxLines="1"
            android:padding="23dp"
            android:backgroundTint="#2d142C"
            android:textColor="#000000" />

        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Contraseña"
            android:inputType="textPassword"
            android:maxLines="1"
            android:padding="24dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="#2d142C"
            android:textColor="#000000"/>

        <Button
            android:id="@+id/btnIngresar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ingresar"
            android:textAllCaps="false"
            android:layout_marginTop="18dp"
            android:backgroundTint="#801336"
            android:textColor="#FFFFFF"/>

    </LinearLayout>

</LinearLayout>