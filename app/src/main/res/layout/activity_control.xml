<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:orientation="vertical">

    <include layout="@layout/view_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/margen_pantalla"
            android:paddingTop="8dp"
            android:paddingEnd="@dimen/margen_pantalla"
            android:paddingBottom="@dimen/margen_pantalla">

            <TextView
                style="@style/Texto.Titulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Control remoto" />

            <TextView
                style="@style/Texto.Subtitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Enlace Bluetooth con el sistema de monitoreo. Si la conexión se pierde, la app reintenta sola." />

            <!-- ===== Conexión ===== -->
            <TextView
                style="@style/Texto.Seccion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/separacion_seccion"
                android:text="Conexión" />

            <LinearLayout
                style="@style/Tarjeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/vPuntoEstado"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/bg_dot"
                        android:backgroundTint="@color/tinta_3" />

                    <TextView
                        android:id="@+id/tvEstadoConexion"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:text="Desconectado"
                        android:textColor="@color/tinta"
                        android:textSize="17sp" />

                    <TextView
                        android:id="@+id/tvDispositivo"
                        style="@style/Texto.Eyebrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip"
                        android:paddingStart="10dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="4dp"
                        android:text="HC-06"
                        android:textAllCaps="false"
                        android:letterSpacing="0.02" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvDetalleConexion"
                    style="@style/Texto.Etiqueta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="4dp"
                    android:text="Selecciona el módulo emparejado para comenzar." />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConectar"
                    style="@style/Boton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Conectar dispositivo" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/separacion_chica"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnReintentar"
                        style="@style/BotonSecundario"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:enabled="false"
                        android:text="Reintentar" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDesconectar"
                        style="@style/BotonSecundario.Peligro"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:enabled="false"
                        android:text="Desconectar" />
                </LinearLayout>
            </LinearLayout>

            <!-- ===== Lecturas en vivo ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/separacion_seccion"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Texto.Seccion"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="En vivo" />

                <TextView
                    android:id="@+id/tvEstadoSistema"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip"
                    android:backgroundTint="@color/superficie_alt"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:text="Esperando datos"
                    android:textColor="@color/tinta_2"
                    android:textSize="12sp" />
            </LinearLayout>

            <include
                layout="@layout/view_lecturas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp" />

            <!-- ===== Integridad ===== -->
            <TextView
                style="@style/Texto.Seccion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/separacion_seccion"
                android:text="Integridad de datos" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvValidas"
                            style="@style/Texto.Dato"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0" />

                        <TextView
                            style="@style/Texto.Etiqueta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Válidas"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvRechazadas"
                            style="@style/Texto.Dato"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0" />

                        <TextView
                            style="@style/Texto.Etiqueta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rechazadas"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvPerdidas"
                            style="@style/Texto.Dato"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0" />

                        <TextView
                            style="@style/Texto.Etiqueta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Perdidas"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvReconexiones"
                            style="@style/Texto.Dato"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0" />

                        <TextView
                            style="@style/Texto.Etiqueta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Reconex."
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/borde" />

                <TextView
                    android:id="@+id/tvIntegridadDetalle"
                    style="@style/Texto.Etiqueta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="14dp"
                    android:text="Próximo registro en la base de datos: con la primera lectura."
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- ===== Comando ===== -->
            <TextView
                style="@style/Texto.Seccion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/separacion_seccion"
                android:text="Comando remoto" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEnviarA"
                style="@style/Boton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:enabled="false"
                android:text="Enviar «A» · parpadear LED verde" />

            <!-- ===== Terminal ===== -->
            <TextView
                style="@style/Texto.Seccion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/separacion_seccion"
                android:text="Mensajes del Arduino" />

            <TextView
                android:id="@+id/tvNotificaciones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_terminal"
                android:fontFamily="monospace"
                android:lineSpacingExtra="4dp"
                android:minHeight="96dp"
                android:padding="14dp"
                android:text="› sin mensajes todavía"
                android:textColor="@color/terminal_texto"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHistorial"
                style="@style/BotonSecundario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/separacion_seccion"
                android:text="Ver historial de registros" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
