<?xml version="1.0" encoding="utf-8"?>
<!-- Encabezado claro: botón volver circular + chip con el paso actual -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/margen_pantalla"
    android:paddingEnd="@dimen/margen_pantalla">

    <ImageButton
        android:id="@+id/btnVolver"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_btn_volver"
        android:contentDescription="Volver"
        android:src="@drawable/ic_volver" />

    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/tvPaso"
        style="@style/Texto.Eyebrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_chip"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp" />

</LinearLayout>
